* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Editable 3D assets and high-dynamic-range images.
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
/Unity/Assets/StreamingAssets/scene.bin filter=lfs diff=lfs merge=lfs -text
/Unity/Assets/StreamingAssets/scene.json filter=lfs diff=lfs merge=lfs -text

# Portfolio previews stay in normal Git so GitHub can show them in the README.
*.png binary
*.jpg binary
*.jpeg binary
